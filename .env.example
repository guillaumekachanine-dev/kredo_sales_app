# ============================================================
#  KREDO — Variables d'environnement
#  Copier ce fichier en .env.local et renseigner les valeurs.
#  .env.local n'est JAMAIS commité (voir .gitignore).
# ============================================================

# --- Supabase (côté client : publiques, sans danger) ---
NEXT_PUBLIC_SUPABASE_URL=https://jvzgmhvwirsbdkjpmvla.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon — Settings > API > Project API keys>

# --- Supabase (côté serveur UNIQUEMENT : secret absolu) ---
# Ne JAMAIS préfixer par NEXT_PUBLIC_. Contourne la RLS : usage serveur/n8n seulement.
SUPABASE_SERVICE_ROLE_KEY=<clé service_role — à garder secrète>

# --- n8n (déclenchement des workflows asynchrones) ---
N8N_WEBHOOK_BASE_URL=https://n8n.srv1209998.hstgr.cloud
N8N_WEBHOOK_SECRET=<jeton partagé pour authentifier les appels Next.js -> n8n>
N8N_CRON_SECRET=<jeton partagé pour authentifier les déclenchements planifiés n8n -> Next.js>

# Identifiant stable du workflow de veille globale existant. À renseigner
# uniquement après vérification dans n8n ; sans valeur, /veille affiche
# « À contrôler » et désactive l’actualisation manuelle.
NEXT_PUBLIC_GLOBAL_WATCH_WORKFLOW_ID=<identifiant stable vérifié>

# --- n8n (côté client : URL publique, sans danger — sert uniquement à construire
#     le lien "Ouvrir dans n8n" du drill-down /automations, jamais un secret) ---
NEXT_PUBLIC_N8N_BASE_URL=https://n8n.srv1209998.hstgr.cloud

# --- n8n API (lecture seule, pour `npm run n8n:status` — détecte la dérive
#     entre les workflows versionnés dans n8n/workflows/ et ce qui tourne
#     réellement sur le VPS) ---
# Génère la clé : VPS n8n -> Settings -> n8n API -> Create an API Key
N8N_API_URL=https://n8n.srv1209998.hstgr.cloud
N8N_API_KEY=<clé API n8n — Settings > n8n API>
