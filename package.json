{
  "name": "kredo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:server-boundary": "node scripts/check-server-boundary.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "gen:comm-manifest": "node scripts/generate-communication-manifest.mjs",
    "logos:attach": "node --env-file=.env.local scripts/attach-company-logos.mjs",
    "n8n:status": "node --env-file=.env.local scripts/n8n-status.mjs",
    "test": "vitest run",
    "test:n8n": "for f in n8n/workflows/__tests__/*.test.js; do echo \"── $f\"; node \"$f\" || exit 1; done",
    "ft:check": "node --env-file=.env.local scripts/check-france-travail-credentials.mjs",
    "ft:probe": "node --env-file=.env.local scripts/probe-france-travail-api.mjs",
    "ft:measure": "tsx --conditions=react-server --env-file=.env.local scripts/measure-hiring-intensity.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.0",
    "@vercel/speed-insights": "^2.0.0",
    "d3-shape": "^3.2.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
