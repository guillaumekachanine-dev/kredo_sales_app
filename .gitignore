# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# prototypes et bacs à sable versionnés sous docs/ : jamais leurs dépendances ni leurs builds
**/node_modules/
**/.npm-cache/
docs/**/cockpit-mobile-prototype/dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design outputs (logos, exports)
/outputs/

# local agent and playwright test state
.claude/
.playwright-cli/
playwright/.auth/
.screenshots/
supabase/.temp/

# doublons de conflit iCloud Drive (le projet vit sous ~/Desktop, synchronisé
# via "Dossiers Bureau et Documents" — cf. investigation du 2026-08-10).
# iCloud interprète les réécritures rapprochées (builds Next.js notamment)
# comme des conflits et crée "nom N.ext" / "dossier N". Motif vérifié sans
# faux positif sur l'état actuel du dépôt (`git ls-files | grep -E ' [0-9]'`).
# Ne dispense pas de vérifier le contenu avant de supprimer un fichier qui y
# correspond : "styles 2.css" trouvé lors de cette même investigation n'était
# PAS un doublon, mais une version antérieure réelle du fichier.
* [0-9].*
* [0-9]/

.codex/auth-state.json
.codex/auth-state.json
